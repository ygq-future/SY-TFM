{
  "name": "sy-tfm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SY-TFM — Tiny File Manager (Tauri 2 + React 19 + Rust)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "types:format": "prettier --write --ignore-path .gitignore src/types/enums src/types/generated",
    "types:export": "cargo test --test export_types --manifest-path src-tauri/Cargo.toml && bun run types:format"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/view": "^6.43.6",
    "@dnd-kit/core": "^6.3.0",
    "@tanstack/react-query": "^5.80.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-opener": "~2",
    "@uiw/react-codemirror": "^4.24.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "i18next": "^25.0.0",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.0.0",
    "react-router": "^7.8.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/node": "^24",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
